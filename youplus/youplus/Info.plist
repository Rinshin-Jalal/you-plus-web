<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Background Modes for Voice Calls -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>voip</string>
	</array>

	<!-- Microphone Usage Description -->
	<key>NSMicrophoneUsageDescription</key>
	<string>We need microphone access to enable voice calls with your Future Self.</string>

	<!-- CallKit Configuration (required for CallKit to work) -->
	<key>CXCallKitEnabled</key>
	<true/>
</dict>
</plist>

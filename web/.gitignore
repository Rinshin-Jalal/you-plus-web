# ═══════════════════════════════════════════════════════════════════════════
# YOU+ Web (Next.js) .gitignore
# ═══════════════════════════════════════════════════════════════════════════
# Note: Root .gitignore handles common patterns (node_modules, .env, AI agents, etc.)

# Next.js
/.next/
/out/
/build/
next-env.d.ts

# Vercel
.vercel
.open-next/
.build/
.wrangler/
.mf/
.miniflare/
.dev.vars

# Testing
/coverage

# TypeScript
*.tsbuildinfo

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Trigger.dev
.trigger

# AI Agents (also in root, but explicit here)
.cursor/
.claude/
.windsurf/
.opencode/

# Environment (also in root)
.env*
!.env.example
